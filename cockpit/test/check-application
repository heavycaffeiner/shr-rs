#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import json

import testlib


# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and
# RHEL dist-git gating. They must not permanently change any file or configuration on the system in a
# way that influences other tests.
@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def testBasic(self):
        b = self.browser
        m = self.machine

        report = json.loads(m.execute("shr-rs status --json"))
        self.assertEqual(report["schema_version"], 2)
        self.assertIn(report["health"], ["healthy", "degraded", "unknown"])

        self.login_and_go("/shr-rs")
        b.wait_text("h1", "SHR-RS RAID Manager")
        # Aria labels, not class names. The UI is built out of PatternFly
        # components whose emitted classes are the framework's to change; the
        # aria labels are ours and are what a screen reader sees, so asserting
        # on them tests the page rather than the version of PatternFly.
        b.wait_visible("[aria-label='스토리지 상태 요약']")
        b.wait_in_text("[aria-label='스토리지 상태 요약']", "구성 드라이브")
        b.wait_in_text("[aria-label='감지된 물리 용량']", "물리 디스크 크기의 합계")


if __name__ == '__main__':
    testlib.test_main()
